  description: "AI gra pasywnie, zajmuje wysokie wzg\xF3rze za rzek\u0105 i czeka,
    a\u017C gracz (Rzym) pope\u0142ni b\u0142\u0105d i zacznie przepraw\u0119. Wtedy
    AI uderza kawaleri\u0105 z ukrycia."
  battlePhases:
  - phaseName: "Obrona Wzg\xF3rza"
    trigger: 1
    triggerValue: 100
    commands:
    - note: "Goci zajmuj\u0105 pozycj\u0119 na Wzg\xF3rzu P\xF3\u0142nocnym, u\u017Cywaj\u0105c
        rzeki jako fosy"
      action: 2
      unitTag: Infantry
      targetName: "Wzg\xF3rze P\xF3\u0142noc"
      formation: Line
    - note: "Goci zajmuj\u0105 pozycj\u0119 na Wzg\xF3rzu P\xF3\u0142nocnym, u\u017Cywaj\u0105c
        rzeki jako fosy"
      action: 2
      unitTag: Archer
      targetName: "Wzg\xF3rze P\xF3\u0142noc"
      formation: Loose
    - note: "Goci zajmuj\u0105 pozycj\u0119 na Wzg\xF3rzu P\xF3\u0142nocnym, u\u017Cywaj\u0105c
        rzeki jako fosy"
      action: 2
      unitTag: Cavalry
      targetName: "Wzg\xF3rze P\xF3\u0142noc_Back"
      formation: Wedge
  - phaseName: "Ostrza\u0142 przeprawy"
    trigger: 1
    triggerValue: 200
    commands:
    - note: "Gdy Rzymianie wejd\u0105 do wody, Goci utrzymuj\u0105 pozycj\u0119,
        nie daj\u0105c si\u0119 wywabi\u0107"
      action: 4
      unitTag: All
      targetName: 
